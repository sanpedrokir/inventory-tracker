generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InventoryItem {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  quantity  Int
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}